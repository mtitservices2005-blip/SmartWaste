{
  "buildCommand": "node scripts/build-frontend-config.mjs",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/en-vivo",
      "destination": "/en-vivo.html"
    },
    {
      "source": "/privacidad",
      "destination": "/privacidad.html"
    },
    {
      "source": "/descargar",
      "destination": "/descargar.html"
    }
  ],
  "headers": [
    {
      "source": "/downloads/version.json",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/downloads/(.*)\\.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"SmartWaste-Conductor.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    }
  ]
}
